{
  "name": "atlas-harbor",
  "version": "0.1.0",
  "private": true,
  "description": "A supply-chain decision game for translating complex choices into playable systems.",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-js.js",
    "prestart": "npm run check",
    "start": "node src/server.js",
