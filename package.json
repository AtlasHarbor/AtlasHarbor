    "test": "node --test",
    "test:auth": "node scripts/test-auth-api.js",
    "seed:legal": "node scripts/seed-legal.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "^3.90.0"
  }
}
