# Copy this file to .env and replace placeholders locally or in your host.
# Never commit .env or real credentials.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

PUBLIC_APP_URL=http://localhost:3000
OPENROUTER_LEGAL_MODEL=openai/gpt-5.2
LEGAL_ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
OPENROUTER_API_KEY=OPTIONAL_SERVER_MANAGED_KEY

# Required before an administrator saves global AI provider keys.
# Use a long, stable random value. Changing it makes previously encrypted keys unreadable.
ADMIN_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_ENCRYPTION_SECRET

# Food discovery works without credentials using OpenStreetMap/Nominatim/Overpass.
# Optional: enables Google Places ratings, review excerpts, hours, and review summaries.
GOOGLE_PLACES_API_KEY=YOUR_SERVER_SIDE_GOOGLE_PLACES_KEY

# Map provider. "openstreetmap" works without credentials and is the default.
# For Google Maps, set MAP_PROVIDER=google and provide a browser-restricted key.
MAP_PROVIDER=openstreetmap
GOOGLE_MAPS_BROWSER_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
# Optional alternate OSM-compatible tile endpoint for production deployments.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
