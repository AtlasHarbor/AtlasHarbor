# Copy this file to .env and replace placeholders locally or in your host.
# Never commit .env or real credentials.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Use one server-side service key name. SUPABASE_SECRET_KEY is preferred;
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_SERVICE_KEY are accepted aliases.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Startup migrations use a private PostgreSQL connection from the bundled Node client.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@HOST:5432/postgres?sslmode=require
AUTO_MIGRATE=true
MIGRATION_FAILURE_MODE=continue

PUBLIC_APP_URL=http://localhost:3000
ADMIN_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_ENCRYPTION_SECRET

# Legal data. CourtListener/RECAP is the primary structured docket and filing source.
# The application still seeds repository case records without a token, but authenticated
# API access improves reliability and allows scheduled docket/document synchronization.
COURTLISTENER_API_TOKEN=YOUR_COURTLISTENER_API_TOKEN

# Optional server-managed Perplexity key used by Admin Legal/Economics research.
# Ordinary users can instead keep their own Perplexity key locally in the browser.
PERPLEXITY_API_KEY=OPTIONAL_SERVER_MANAGED_PERPLEXITY_KEY

# Legacy/optional Legal AI settings. CourtListener synchronization does not require AI.
OPENROUTER_LEGAL_MODEL=openai/gpt-5.2
LEGAL_ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
OPENROUTER_API_KEY=OPTIONAL_SERVER_MANAGED_KEY

GOOGLE_PLACES_API_KEY=YOUR_SERVER_SIDE_GOOGLE_PLACES_KEY

# Optional normalized JUCO baseball JSON feed. Expected shape:
# {"games":[...],"players":[{"id":"...","name":"...","team":"...","position":"..."}]}
# JUCO organizations do not currently expose one stable, comprehensive free public API.
JUCO_BASEBALL_FEED_URL=

MAP_PROVIDER=openstreetmap
GOOGLE_MAPS_BROWSER_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_KEY
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
